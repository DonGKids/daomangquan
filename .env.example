# 导茫犬平台环境变量配置示例
# 复制本文件为 .env 并修改对应值后使用

# 会话加密密钥（生产环境必须设置为随机强密钥）
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=请替换为随机生成的强密钥

# 调试模式（生产环境必须设为 0）
FLASK_DEBUG=1

# 服务监听地址（0.0.0.0 表示对外开放，127.0.0.1 表示仅本机）
FLASK_HOST=127.0.0.1

# 服务监听端口
FLASK_PORT=5000

# 数据库文件路径（默认为项目根目录下的 daomangquan.db）
# DATABASE=daomangquan.db
